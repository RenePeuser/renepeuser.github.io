---
// Starlight Pagination override: adds Giscus comments (GitHub Discussions) below blog posts only.
import Default from '@astrojs/starlight/components/Pagination.astro';

const route = Astro.locals.starlightRoute;
const isBlogPost = route.id.startsWith('blog/') && 'date' in route.entry.data && route.entry.data.date;
---

{
	isBlogPost && (
		<section class="comments" aria-label="Comments">
			<h2>Comments</h2>
			<div class="giscus" />
			<script
				is:inline
				src="https://giscus.app/client.js"
				data-repo="RenePeuser/renepeuser.github.io"
				data-repo-id="R_kgDOV4qrJw"
				data-category="Announcements"
				data-category-id="DIC_kwDOV4qrJ84DLyZk"
				data-mapping="pathname"
				data-strict="1"
				data-reactions-enabled="1"
				data-emit-metadata="0"
				data-input-position="top"
				data-theme={'preferred_color_scheme'}
				data-lang="en"
				data-loading="lazy"
				crossorigin="anonymous"
				async
			/>
			<script is:inline>
				// Keep the Giscus theme in sync with Starlight's theme switcher.
				(() => {
					const current = () => document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
					const send = () => {
						const frame = document.querySelector('iframe.giscus-frame');
						frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: current() } } }, 'https://giscus.app');
					};
					new MutationObserver(send).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
					window.addEventListener('message', (e) => { if (e.origin === 'https://giscus.app') send(); }, { once: true });
				})();
			</script>
		</section>
	)
}
<Default />

<style>
	.comments {
		margin-top: 3rem;
	}
	.comments h2 {
		font-size: var(--sl-text-h3);
		margin-bottom: 1rem;
	}
</style>
